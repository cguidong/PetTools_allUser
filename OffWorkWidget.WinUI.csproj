<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>OffWorkWidget.WinUI</RootNamespace>
    <AssemblyName>OffWorkWidget.WinUI</AssemblyName>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyTitle>有盼</AssemblyTitle>
    <Product>有盼</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('assets\app-icon.ico')">assets\app-icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;publish\**;publish-*\**;work\**</DefaultItemExcludes>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en;zh-Hans;zh-Hant</SatelliteResourceLanguages>
    <PublishAot>false</PublishAot>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets\china-holidays-2026.json" LogicalName="china-holidays-2026.json" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="LiquidGlassWinUI" Version="1.0.3" />
    <PackageReference Include="WinUIEx" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Keep the original transparent WebM and gzip masters in the repo, but do not ship them. -->
    <Content Remove="assets\**\*.webm" />
    <Content Remove="assets\**\*.frames.gz" />
    <Content Include="prerequisites\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="使用说明.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="LiquidGlassWinUI-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
    <ApplicationDefinition Include="App.xaml" />
  </ItemGroup>
  <Target Name="PublishCompiledAppXaml" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)App.xbf')" Text="Missing compiled App.xbf; publish stopped." />
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="Missing application PRI; publish stopped." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)App.xbf" RelativePath="App.xbf" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri" RelativePath="$(AssemblyName).pri" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="ExcludeUnusedMachineLearningRuntime" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <!-- The application does not use Windows ML; retain UI and .NET Core runtime components. -->
      <!-- Replace desktop-framework facades even if the old DLL has a newer timestamp. -->
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Filename)' == 'WindowsBase' Or '%(ResolvedFileToPublish.Filename)' == 'System.Drawing' Or '%(ResolvedFileToPublish.Filename)' == 'Microsoft.VisualBasic'">
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Filename)' == 'DirectML' Or '%(ResolvedFileToPublish.Filename)' == 'onnxruntime' Or '%(ResolvedFileToPublish.Filename)' == 'Microsoft.Windows.AI.MachineLearning'" />
    </ItemGroup>
  </Target>
  <Target Name="RemoveLegacyAnimationSources" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <StaleAnimationFiles Include="$(PublishDir)assets\*.frames.gz;$(PublishDir)assets\*.webm" />
    </ItemGroup>
    <Delete Files="@(StaleAnimationFiles)" />
  </Target>
  <Target Name="RemoveStaleOptionalRuntimeFiles" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <StaleOptionalRuntimeFiles Include="$(PublishDir)DirectML.dll;$(PublishDir)onnxruntime.dll;$(PublishDir)Microsoft.Windows.AI.MachineLearning.dll" />
      <StaleOptionalRuntimeFiles Include="$(PublishDir)cs\*.resources.dll;$(PublishDir)de\*.resources.dll;$(PublishDir)es\*.resources.dll;$(PublishDir)fr\*.resources.dll;$(PublishDir)it\*.resources.dll;$(PublishDir)ja\*.resources.dll;$(PublishDir)ko\*.resources.dll;$(PublishDir)pl\*.resources.dll;$(PublishDir)pt-BR\*.resources.dll;$(PublishDir)ru\*.resources.dll;$(PublishDir)tr\*.resources.dll" />
    </ItemGroup>
    <Delete Files="@(StaleOptionalRuntimeFiles)" />
  </Target>
  <Target Name="RemoveStaleWindowsDesktopRuntimeFiles" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <StaleDesktopRuntimeFiles Include="$(PublishDir)Accessibility.dll" />
      <StaleDesktopRuntimeFiles Include="$(PublishDir)D3DCompiler_47_cor3.dll" />
      <StaleDesktopRuntimeFiles Include="$(PublishDir)DirectWriteForwarder.dll" />
      <StaleDesktopRuntimeFiles Include="$(PublishDir)Microsoft.VisualBasic.Forms.dll" />
      <StaleDesktopRuntimeFiles Include="$(PublishDir)Microsoft.Win32.Registry.AccessControl.dll" />
      <StaleDesktopRuntimeFiles Include="$(PublishDir)Microsoft.Win32.SystemEvents.dll" />
      <StaleDesktopRuntimeFiles Include="$(PublishDir)PenImc_cor3.dll" />
      <StaleDesktopRuntimeFiles Include="$(PublishDir)PresentationCore.dll" />
      <StaleDesktopRuntimeFiles Include="$(PublishDir)PresentationFramework-SystemCore.dll" />
      <StaleDesktopRuntimeFiles Include="$(PublishDir)PresentationFramework-SystemData.dll" />
      <StaleDesktopRuntimeFiles Include="$(PublishDir)PresentationFramework-SystemDrawing.dll" />
      <StaleDesktopRuntimeFiles Include="$(PublishDir)PresentationFramework-SystemXml.dll" />
      <StaleDesktopRuntimeFiles Include="$(PublishDir)PresentationFramework-SystemXmlLinq.dll" />
      <StaleDesktopRuntimeFiles Include="$(PublishDir)PresentationFramework.Aero.dll" />
      <StaleDesktopRuntimeFiles Include="$(PublishDir)PresentationFramework.Aero2.dll" />
